{
  "name": "@idfon/monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "pnpm cli clean && pnpm mac clean && pnpm ios clean && pnpm native clean && pnpm --filter eve-idfon-channel clean",
    "native": "pnpm --filter @idfon/native",
    "all": "pnpm --filter @idfon/*",
    "cli": "pnpm --filter @idfon/cli",
    "ios": "pnpm --filter @idfon/ios",
    "mac": "pnpm --filter @idfon/mac",
    "eve": "bash ./scripts/eve.sh",
    "pair": "bash ./scripts/pair-apple-channels.sh",
    "agent": "bash ./scripts/agent.sh"
  },
  "author": "Don Park",
  "license": "(MIT OR Apache-2.0)",
  "packageManager": "pnpm@10.30.1"
}
