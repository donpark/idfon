{
  "name": "@idfon/monorepo",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "clean": "bash ./scripts/build.sh clean",
    "clean:build-cache": "rm -rf target ~/.cargo/registry/src",
    "native": "pnpm --filter @idfon/native",
    "all": "pnpm --filter @idfon/*",
    "cli": "pnpm --filter @idfon/cli",
    "ios": "pnpm --filter @idfon/ios",
    "mac": "pnpm --filter @idfon/mac",
    "eve": "bash ./scripts/eve.sh",
    "voice": "bash ./scripts/voice.sh",
    "pair": "bash ./scripts/pair-apple-channels.sh",
    "agent": "bash ./scripts/agent.sh",
    "idfon": "node cli/idfon/bin/idfon.js",
    "edge": "bash ./scripts/edge.sh",
    "deploy:do": "bash ./scripts/deploy-digitalocean.sh",
    "deploy:do:relay": "IDFON_DEPLOY_RELAY=1 bash ./scripts/deploy-digitalocean.sh"
  },
  "author": "Don Park",
  "license": "(MIT OR Apache-2.0)",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
