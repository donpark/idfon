<column gap="12" padding="16">
  <!-- Call header: participant avatars left, call controls + feedback right.
       The peer name lives in the window title bar. -->
  <row cross="center" gap="8">
    <stack>
      <!-- on-press opens the peer-details sheet; the press binding also makes the avatar a hit target so the tooltip's hover intent arms (avatars are otherwise not hittable). -->
      <avatar label="{selectedConnectionName}" on-press="avatar_pressed">{selectedConnectionInitials}</avatar>
      <tooltip anchor="above">{selectedConnectionName}</tooltip>
    </stack>
  <spacer grow="1" />
  <if test="{incomingLive}">
    <button variant="primary" on-press="live_answer">Answer</button>
    <button variant="secondary" on-press="live_decline">Decline</button>
  </if>
  <else>
    <if test="{callActive}">
      <button variant="destructive" on-press="live_stop">End call</button>
    </if>
    <else>
      <button size="icon" variant="primary" icon="app:video" on-press="video_call_start" label="Start video call"></button>
      <button size="icon" variant="primary" icon="app:phone" on-press="live_start" label="Start call"></button>
    </else>
  </else>
  </row>
  <if test="{bannerVisible}">
    <!-- Message banner: one markdown notice, auto-expires (~5s via the events poll); a new notice replaces the standing one. -->
    <row cross="center" gap="8" padding="8" radius="md" background="surface_subtle">
      <markdown source="{bannerText}" on-link="open_link" />
      <button size="icon" variant="ghost" icon="x" on-press="banner_dismiss" label="Dismiss"></button>
    </row>
  </if>
  <separator />
  <scroll grow="1">
    <column gap="8">
      <if test="{historyEmpty}">
        <column cross="center" gap="4" padding="32">
          <text foreground="text_muted">No messages yet</text>
          <text foreground="text_muted">Send a message or record a voice note</text>
        </column>
      </if>
      <for each="history" key="id" as="item">
        <if test="{item.isAudio}">
          <if test="{item.audioReady}">
            <if test="{item.sent}">
              <row main="end">
                <bubble variant="primary">
                  <row gap="8" cross="center">
                    <if test="{item.audio == playingTicket}">
                      <button size="icon" variant="secondary" icon="pause" on-press="audio_toggle:{item.id}" label="Pause voice message"></button>
                    </if>
                    <else>
                      <button size="icon" variant="secondary" icon="play" on-press="audio_toggle:{item.id}" label="Play voice message"></button>
                    </else>
                    <icon name="app:wave" width="18" height="18" foreground="accent_text" />
                    <text>{item.duration}</text>
                  </row>
                </bubble>
              </row>
            </if>
            <else>
              <row main="start" gap="8">
                <stack>
                  <avatar label="{selectedConnectionName}" on-press="avatar_pressed">{selectedConnectionInitials}</avatar>
                  <tooltip anchor="above">{selectedConnectionName}</tooltip>
                </stack>
                <bubble>
                  <row gap="8" cross="center">
                    <if test="{item.audio == playingTicket}">
                      <button size="icon" variant="secondary" icon="pause" on-press="audio_toggle:{item.id}" label="Pause voice message"></button>
                    </if>
                    <else>
                      <button size="icon" variant="secondary" icon="play" on-press="audio_toggle:{item.id}" label="Play voice message"></button>
                    </else>
                    <icon name="app:wave" width="18" height="18" foreground="text_muted" />
                    <text foreground="text_muted">{item.duration}</text>
                  </row>
                </bubble>
              </row>
            </else>
          </if>
        </if>
        <else>
          <if test="{item.sent}">
            <row main="end">
              <bubble variant="primary"><markdown source="{item.text}" on-link="open_link" /></bubble>
            </row>
          </if>
          <else>
            <row main="start" gap="8">
              <stack>
                  <avatar label="{selectedConnectionName}" on-press="avatar_pressed">{selectedConnectionInitials}</avatar>
                  <tooltip anchor="above">{selectedConnectionName}</tooltip>
                </stack>
              <bubble><markdown source="{item.text}" on-link="open_link" /></bubble>
            </row>
          </else>
        </else>
      </for>
    </column>
  </scroll>
  <if test="{recordingActive}">
    <!-- Messages-style recording bar: red pill with live waveform and timer;
         the stop button is pinned at the right edge so it never moves. -->
    <row cross="center">
      <spacer width="12" />
      <row grow="1" height="44" background="surface_subtle" radius="lg" cross="center" gap="10" padding="8" label="Recording audio">
        <icon name="circle-dot" width="12" height="12" foreground="destructive" />
        <text foreground="destructive">Recording…</text>
        <spacer grow="1" />
        <chart y-min="0" y-max="1" grid-lines="0" height="22" grow="1" label="Microphone level">
          <series values="{waveform}" kind="bar" color="destructive" />
        </chart>
        <text foreground="destructive">{recordingElapsed}</text>
      </row>
      <button size="icon" variant="destructive" icon="x" on-press="recording_stop" label="Stop recording"></button>
      <spacer width="12" />
    </row>
  </if>
  <if test="{recordingReady}">
    <!-- Messages-style playback pill: discard, preview, duration, send. -->
    <row cross="center">
      <spacer width="12" />
      <button size="icon" variant="ghost" icon="x" on-press="recording_cancel" label="Discard recording"></button>
      <row grow="1" height="44" background="surface_subtle" radius="lg" cross="center" gap="10" padding="8" label="Voice message preview">
        <button size="icon" variant="ghost" icon="play" on-press="recording_preview" label="Preview recording"></button>
        <text foreground="text_muted">Voice message · {recordingDuration} sec</text>
        <spacer grow="1" />
      </row>
      <button size="icon" variant="primary" icon="arrow-up" disabled="{senderDisabled}" on-press="send_message" label="Send recording"></button>
      <spacer width="12" />
    </row>
  </if>
  <if test="{videoWatching}">
    <!-- Live video watch: the decoded adaptive stream renders through the
         runtime image registry (host writes JPEG frames to app-data). -->
    <row cross="center">
      <image image="{videoImageId}" width="{videoWidth}" height="{videoHeight}" label="Live video" />
      <button variant="destructive" on-press="video_stop" label="Stop video">Stop video</button>
    </row>
  </if>
  <else>
    <row gap="8" cross="center">
      <text-field text="{videoFileInput}" label="Video file to share" placeholder="Path to a fragmented MP4" on-input="video_file_edit" />
      <button variant="secondary" on-press="video_share" label="Share video">Share video</button>
    </row>
  </else>
  <!-- Messages-style composer: + on the left, one pill field, record/send
       swap on the field's right edge (record when empty, send when typing). -->
  <if test="{composerIdle}">
    <row cross="center">
      <spacer width="12" />
      <button size="icon" variant="secondary" icon="plus" on-press="attach_file" label="Attach file"></button>
      <spacer width="4" />
      <input-group grow="1" height="44" label="Message composer">
        <textarea text="{message}" placeholder="Message" submit-on-enter="true" on-input="message_edit" on-submit="send_message" label="Message" />
      </input-group>
      <spacer width="4" />
      <if test="{composerActive}">
        <button size="icon" variant="primary" icon="arrow-up" disabled="{senderDisabled}" on-press="send_message" label="Send message"></button>
      </if>
      <else>
        <button size="icon" variant="ghost" icon="app:wave" on-press="recording_start" label="Record audio"></button>
      </else>
      <spacer width="12" />
    </row>
  </if>
  <!-- Peer details sheet: opens from any avatar press, closes on Escape / outside click. -->
  <if test="{avatarSheetOpen}">
    <sheet text="Peer details" width="340" on-dismiss="avatar_sheet_closed">
      <column gap="16" padding="20">
        <row gap="12" cross="center">
          <avatar label="{selectedConnectionName}">{selectedConnectionInitials}</avatar>
          <column gap="2" grow="1">
            <text>{selectedConnectionName}</text>
            <text foreground="text_muted">{receiverId}</text>
          </column>
        </row>
        <separator />
        <button variant="secondary" icon="copy" on-press="copy_endpoint_id">Copy endpoint ID</button>
      </column>
    </sheet>
  </if>
</column>
