<column gap="12" padding="16">
  <row cross="center">
    <avatar label="{selectedConnectionName}">NU</avatar>
    <column gap="2" grow="1">
      <text size="heading">{selectedConnectionName}</text>
      <text foreground="text_muted">{senderStatus}</text>
    </column>
  </row>
  <separator />
  <scroll grow="1">
    <column gap="8">
      <for each="history" key="id" as="item">
        <if test="{item.sent}">
          <row main="end">
            <bubble variant="primary"><text wrap="true">{item.text}</text><text foreground="text_muted">{item.timestamp} · {item.status}</text></bubble>
          </row>
        </if>
        <else>
          <row main="start">
            <avatar label="{selectedConnectionName}">NU</avatar>
            <bubble><text wrap="true">{item.text}</text><text foreground="text_muted">{item.timestamp} · {item.status}</text></bubble>
          </row>
        </else>
      </for>
    </column>
  </scroll>
  <if test="{recordingReady}">
    <row gap="8" cross="center">
      <icon name="music" width="14" height="14" foreground="text_muted" />
      <text grow="1" foreground="text_muted">{recordingDuration} sec audio attached</text>
      <button variant="ghost" size="icon" label="Remove audio attachment" icon="x" on-press="recording_cancel" />
    </row>
  </if>
  <!-- Chatbot-style composer: one bordered input group; attach, record,
       and call actions live in the actions row and swap to a stop button
       while recording or in a call. -->
  <row>
    <spacer width="12" />
    <input-group grow="1" height="78" label="Message composer">
      <textarea text="{message}" placeholder="Write a message…" submit-on-enter="true" on-input="message_edit" on-submit="send_message" label="Message" />
      <input-group-actions>
        <button size="icon" variant="ghost" icon="plus" on-press="attach_file" label="Attach file"></button>
        <button size="sm" variant="ghost" on-press="reply_message">Reply</button>
        <spacer grow="1" />
        <if test="{recordingActive}">
          <button size="icon" variant="destructive" icon="x" on-press="recording_stop" label="Stop recording"></button>
        </if>
        <else>
          <button size="icon" variant="ghost" icon="circle-dot" on-press="recording_start" label="Record audio"></button>
        </else>
        <if test="{liveActive}">
          <button size="icon" variant="destructive" icon="x" on-press="live_stop" label="End call"></button>
        </if>
        <else>
          <if test="{subscribedActive}">
            <button size="icon" variant="destructive" icon="x" on-press="live_stop" label="End call"></button>
          </if>
          <else>
            <button size="icon" variant="ghost" icon="volume" on-press="live_start" label="Call"></button>
          </else>
        </else>
        <button size="icon" variant="primary" icon="arrow-up" disabled="{senderDisabled}" on-press="send_message" label="Send message"></button>
      </input-group-actions>
    </input-group>
    <spacer width="12" />
  </row>

  <row gap="12">
    <text size="sm" foreground="text_muted">{recordingStatus}</text>
    <text size="sm" foreground="text_muted">{liveStatus}</text>
    <text size="sm" foreground="text_muted">{audioStatus}</text>
  </row>

  <if test="{fetchedRecordingReady}">
    <if test="{playbackActive}">
      <button variant="secondary" on-press="playback_stop">Stop received recording</button>
    </if>
    <else>
      <button variant="primary" on-press="playback_start">Play received recording</button>
    </else>
  </if>

  <button variant="secondary" on-press="toggle_advanced">Advanced</button>
  <if test="{showAdvanced}">
    <column gap="8">
      <button variant="secondary" on-press="audio_probe">Test microphone</button>
      <row gap="8" cross="center">
        <text-field text="{volumeInput}" label="Volume 0-100" on-input="volume_edit" />
        <button variant="secondary" on-press="volume_set">Set volume</button>
      </row>
      <button variant="secondary" on-press="audio_emergency_stop">Stop all audio</button>
      <button variant="secondary" on-press="toggle_live_auto_accept">Toggle live-audio approval</button>
      <text foreground="text_muted">{livePolicyStatus}</text>
      <text-field text="{liveTicketInput}" label="Live ticket" placeholder="Paste iroh-live ticket" on-input="live_ticket_edit" />
      <if test="{liveActive}">
        <text>{liveTicket}</text>
        <button variant="secondary" on-press="copy_live_ticket">Copy live ticket</button>
      </if>
      <if test="{subscribedActive}">
        <button variant="secondary" on-press="live_unsubscribe">Stop subscribed audio</button>
      </if>
      <else>
        <button variant="secondary" on-press="live_subscribe">Subscribe to live audio</button>
      </else>
      <if test="{recordingTicket}">
        <text>{recordingTicket}</text>
        <button variant="secondary" on-press="copy_recording_ticket">Copy recording ticket</button>
      </if>
      <text-field text="{blobTicketInput}" label="Blob ticket" placeholder="Paste BlobTicket" on-input="blob_ticket_edit" />
      <button variant="secondary" on-press="blob_fetch">Fetch recording</button>
      <text>{blobStatus}</text>
      <text>{playbackStatus}</text>
    </column>
  </if>
</column>
