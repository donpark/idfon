<column gap="12" padding="16">
  <!-- Call header: participant avatars left, call controls + feedback right.
       The peer name lives in the window title bar. -->
  <row cross="center" gap="8">
  <avatar label="{selectedConnectionName}">NU</avatar>
  <spacer grow="1" />
  <if test="{incomingLive}">
    <text foreground="text_muted">{liveStatus}</text>
    <button size="sm" variant="primary" on-press="live_answer">Answer</button>
    <button size="sm" variant="secondary" on-press="live_decline">Decline</button>
  </if>
  <else>
    <if test="{callActive}">
      <text foreground="text_muted">{liveStatus}</text>
      <button size="sm" variant="destructive" on-press="live_stop">End call</button>
    </if>
    <else>
      <text foreground="text_muted">{senderStatus}</text>
      <button size="icon" variant="primary" icon="volume" on-press="live_start" label="Start call"></button>
    </else>
  </else>
  </row>
  <separator />
  <scroll grow="1">
    <column gap="8">
      <if test="{historyEmpty}">
        <column cross="center" gap="4" padding="32">
          <text foreground="text_muted">No messages yet</text>
          <text foreground="text_muted">Send a message or record a voice note</text>
        </column>
      </if>
      <for each="history" key="id" as="item">
        <if test="{item.isAudio}">
          <if test="{item.audioReady}">
            <if test="{item.sent}">
              <row main="end">
                <bubble variant="primary">
                  <row gap="8" cross="center">
                    <button size="icon" variant="secondary" icon="play" on-press="audio_toggle:{item.id}" label="Play voice message"></button>
                    <icon name="app:wave" width="18" height="18" foreground="accent_text" />
                    <text>{item.duration}</text>
                  </row>
                </bubble>
              </row>
            </if>
            <else>
              <row main="start">
                <avatar label="{selectedConnectionName}">NU</avatar>
                <bubble>
                  <row gap="8" cross="center">
                    <button size="icon" variant="secondary" icon="play" on-press="audio_toggle:{item.id}" label="Play voice message"></button>
                    <icon name="app:wave" width="18" height="18" foreground="text_muted" />
                    <text foreground="text_muted">{item.duration}</text>
                  </row>
                </bubble>
              </row>
            </else>
          </if>
        </if>
        <else>
          <if test="{item.sent}">
            <row main="end">
              <bubble variant="primary"><markdown source="{item.text}" on-link="open_link" /></bubble>
            </row>
          </if>
          <else>
            <row main="start">
              <avatar label="{selectedConnectionName}">NU</avatar>
              <bubble><markdown source="{item.text}" on-link="open_link" /></bubble>
            </row>
          </else>
        </else>
      </for>
    </column>
  </scroll>
  <if test="{recordingActive}">
    <!-- Messages-style recording bar: red pill with live waveform and timer;
         the stop button is pinned at the right edge so it never moves. -->
    <row cross="center">
      <spacer width="12" />
      <row grow="1" height="44" background="surface_subtle" radius="lg" cross="center" gap="10" padding="8" label="Recording audio">
        <icon name="circle-dot" width="12" height="12" foreground="destructive" />
        <text foreground="destructive">Recording…</text>
        <spacer grow="1" />
        <chart y-min="0" y-max="1" grid-lines="0" height="22" grow="1" label="Microphone level">
          <series values="{waveform}" kind="bar" color="destructive" />
        </chart>
        <text foreground="destructive">{recordingElapsed}</text>
      </row>
      <button size="icon" variant="destructive" icon="x" on-press="recording_stop" label="Stop recording"></button>
      <spacer width="12" />
    </row>
  </if>
  <if test="{recordingReady}">
    <!-- Messages-style playback pill: discard, preview, duration, send. -->
    <row cross="center">
      <spacer width="12" />
      <button size="icon" variant="ghost" icon="x" on-press="recording_cancel" label="Discard recording"></button>
      <row grow="1" height="44" background="surface_subtle" radius="lg" cross="center" gap="10" padding="8" label="Voice message preview">
        <button size="icon" variant="ghost" icon="play" on-press="recording_preview" label="Preview recording"></button>
        <text foreground="text_muted">Voice message · {recordingDuration} sec</text>
        <spacer grow="1" />
      </row>
      <button size="icon" variant="primary" icon="arrow-up" disabled="{senderDisabled}" on-press="send_message" label="Send recording"></button>
      <spacer width="12" />
    </row>
  </if>
  <!-- Messages-style composer: + on the left, one pill field, record/send
       swap on the field's right edge (record when empty, send when typing). -->
  <if test="{composerIdle}">
    <row cross="center">
      <spacer width="12" />
      <button size="icon" variant="secondary" icon="plus" on-press="attach_file" label="Attach file"></button>
      <spacer width="4" />
      <input-group grow="1" height="44" label="Message composer">
        <textarea text="{message}" placeholder="Message" submit-on-enter="true" on-input="message_edit" on-submit="send_message" label="Message" />
      </input-group>
      <spacer width="4" />
      <if test="{composerActive}">
        <button size="icon" variant="primary" icon="arrow-up" disabled="{senderDisabled}" on-press="send_message" label="Send message"></button>
      </if>
      <else>
        <button size="icon" variant="ghost" icon="app:wave" on-press="recording_start" label="Record audio"></button>
      </else>
      <spacer width="12" />
    </row>
  </if>
</column>
