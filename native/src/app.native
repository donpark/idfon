<column gap="12" padding="16">
  <row cross="center">
    <text grow="1" size="heading">Nufon</text>
  </row>

  <row gap="8" cross="center">
    <stack>
      <if test="{receiverAvailable}">
        <panel background="success" radius="xl" padding="4">
          <avatar label="{identityName}" selected="{identitySelected}" on-press="identity_pressed">DF</avatar>
        </panel>
      </if>
      <else>
        <if test="{identityError}">
          <panel background="destructive" radius="xl" padding="4">
            <avatar label="{identityName}" selected="{identitySelected}" on-press="identity_pressed">DF</avatar>
          </panel>
        </if>
        <else>
          <if test="{identitySelected}">
            <panel background="accent" radius="xl" padding="4">
              <avatar label="{identityName}" selected="{identitySelected}" on-press="identity_pressed">DF</avatar>
            </panel>
          </if>
          <else>
            <panel background="surface_subtle" radius="xl" padding="4">
              <avatar label="{identityName}" selected="{identitySelected}" on-press="identity_pressed">DF</avatar>
            </panel>
          </else>
        </else>
      </else>
      <tooltip anchor="below" tooltip-delay="0">{identityName}</tooltip>
    </stack>
    <text foreground="text_muted">{receiverStatus}</text>
  </row>

  <if test="{identitySelected}">
    <column gap="8">
      <row cross="center">
        <text grow="1">Connections</text>
        <button variant="secondary" on-press="show_add_connection">Add Connection</button>
      </row>
      <for each="connections" key="name" as="connection">
        <list-item label="{connection.name}" on-press="connection_selected:{connection.name}" on-double-press="connection_opened:{connection.name}" on-submit="connection_opened:{connection.name}">{connection.name}</list-item>
      </for>
    </column>
  </if>

  <if test="{showAddConnection}">
    <dialog text="Add Connection">
      <column gap="8" padding="12">
        <text-field text="{connectionName}" label="Name" placeholder="Connection name" on-input="connection_name_edit" />
        <text-field text="{receiverId}" label="Receiver ID" placeholder="Paste receiver ticket" on-input="receiver_id_edit" />
        <row gap="8">
          <button variant="secondary" on-press="cancel_add_connection">Cancel</button>
          <button variant="primary" on-press="add_connection">Add</button>
        </row>
      </column>
    </dialog>
  </if>
</column>
