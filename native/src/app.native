<column gap="12" padding="16">
  <row cross="center">
    <text grow="1" size="heading">Nufon</text>
  </row>

  <row gap="8" cross="center">
    <for each="identities" key="name" as="identity">
      <if test="{identity.active}">
        <button variant="primary" on-press="identity_selected:{identity.name}">{identity.name}</button>
      </if>
      <else>
        <button variant="secondary" on-press="identity_selected:{identity.name}">{identity.name}</button>
      </else>
    </for>
    <text foreground="text_muted">{receiverStatus}</text>
    <button variant="secondary" on-press="show_add_identity">+</button>
  </row>
  <text-field text="{capabilityTicketInput}" label="Capability ticket" placeholder="Paste capability ticket JSON" on-input="capability_ticket_edit" />
  <button variant="secondary" on-press="issue_capability_ticket">Issue receive ticket</button>
  <row gap="8">
    <text-field text="{bitrateInput}" label="Audio bitrate (kbps)" placeholder="32" on-input="bitrate_edit" />
    <button variant="secondary" on-press="set_audio_bitrate">Set bitrate</button>
  </row>

  <if test="{identitySelected}">
    <column gap="8">
      <row cross="center">
        <text grow="1">Connections</text>
        <button variant="secondary" on-press="show_add_connection">Add Connection</button>
      </row>
      <for each="connections" key="name" as="connection">
        <list-item label="{connection.name}" on-press="connection_selected:{connection.name}" on-double-press="connection_opened:{connection.name}" on-submit="connection_opened:{connection.name}">{connection.name}</list-item>
      </for>
    </column>
  </if>

  <if test="{showAddIdentity}">
    <dialog text="New Identity">
      <column gap="8" padding="12">
        <text-field text="{newIdentityName}" label="Name" placeholder="Identity name" on-input="new_identity_name_edit" />
        <row gap="8">
          <button variant="secondary" on-press="cancel_add_identity">Cancel</button>
          <button variant="primary" on-press="create_identity">Create</button>
        </row>
      </column>
    </dialog>
  </if>

  <if test="{showAddConnection}">
    <dialog text="Add Connection">
      <column gap="8" padding="12">
        <text-field text="{connectionName}" label="Name" placeholder="Connection name" on-input="connection_name_edit" />
        <text-field text="{receiverId}" label="Receiver ID" placeholder="Paste receiver ticket" on-input="receiver_id_edit" />
        <row gap="8">
          <button variant="secondary" on-press="cancel_add_connection">Cancel</button>
          <button variant="primary" on-press="add_connection">Add</button>
        </row>
      </column>
    </dialog>
  </if>
</column>
