<column gap="12" padding="16">
  <row cross="center">
    <text grow="1" size="heading">Iroh Echo</text>
    <text foreground="text_muted">Sender + Receiver</text>
  </row>

  <panel padding="12">
    <column gap="8">
      <text>Receiver</text>
      <text foreground="text_muted">Start a persistent Iroh endpoint.</text>
      <button variant="primary" on-press="connect_receiver">Connect receiver</button>
      <text>{receiverStatus}</text>
      <text foreground="text_muted">Public key: {receiverKey}</text>
      <text foreground="text_muted">Address: {receiverTicket}</text>
    </column>
  </panel>

  <panel padding="12">
    <column gap="8">
      <text>Sender</text>
      <text-field text="{message}" placeholder="Message to echo" on-input="message_edit" />
      <button variant="secondary" disabled="{senderDisabled}" on-press="send_message">Send message</button>
      <text>{senderStatus}</text>
    </column>
  </panel>
</column>
