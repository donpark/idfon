{
  "name": "@nufon/native",
  "description": "Native-SDK version of Nufon.",
  "private": true,
  "scripts": {
    "build": "native build -Dtrace=off && native package --target macos --binary 'zig-out/bin/Nufon' --output 'Nufon.app'",
    "run:app": "open -n 'Nufon.app'",
    "run:bin": "open -n 'zig-out/bin/Nufon'"
  },
  "dependencies": {
    "@native-sdk/core": "0.10.1"
  }
}
