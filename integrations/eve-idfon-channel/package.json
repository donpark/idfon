{
  "name": "eve-idfon-channel",
  "version": "0.5.0",
  "description": "Eve ingress channel that turns an idfon peer into a first-class Eve agent contact: cryptographic peer-identity auth, no public endpoint.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donpark/idfon.git",
    "directory": "integrations/eve-idfon-channel"
  },
  "author": "Don Park",
  "keywords": [
    "eve",
    "idfon",
    "iroh",
    "channel",
    "p2p",
    "agent",
    "extension"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension",
      "externalDependencies": []
    }
  },
  "files": [
    "dist",
    "bridge.mjs",
    "managed.mjs",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "bin": {
    "eve-idfon-channel": "./managed.mjs"
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "eve-idfon-channel-darwin-arm64": "0.5.0",
    "eve-idfon-channel-darwin-x64": "0.5.0",
    "eve-idfon-channel-linux-arm64": "0.5.0",
    "eve-idfon-channel-linux-x64": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eve": "0.55.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "eve": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  }
}
