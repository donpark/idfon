**/node_modules/
.zig-cache/
*.app
/target/
audio-source.wav
audio-decoded.wav
audio-aligned.wav
audio-quality.json
stream-decoded.wav
stream-timings.json
geo-decoded.wav
geo-timings.json
# cli platform packages: binaries are built by scripts/build-cli.sh, not committed
cli/idfon-*/bin/
# generated copies of the root license files
cli/idfon-*/LICENSE-*

# eve channel platform packages: built by scripts/build-eve.sh
integrations/eve-idfon-*/bin/
integrations/eve-idfon-*/LICENSE-*
# third-party skills are per-machine installs, not repo content:
#   npx skills add vercel-labs/native        -> native-sdk
#   npx skills add jakubkrehel/make-interfaces-feel-better
#   npx skills add humanlayer/skills --skill show-me
.agents/skills/make-interfaces-feel-better/
.agents/skills/native-sdk/
.agents/skills/show-me/
# local tooling state — not repo content (our own .agents/skills/ ARE tracked)
.pi/
PONYTAIL-DEBT.md
skills-lock.json
*.wav
.DS_Store

# Runtime blob store written by the Eve holder when --blob-dir is not set
blobs/

# iOS app build artifacts
ios/Vendor/
ios/.derived/
mac/.build/
# mac app links this dylib from Vendor/; built by pnpm cli/mac build, not repo content
mac/Vendor/*.dylib

# eve agent build artifacts
agents/*/.output/
agents/*/.eve/
# directory provisioner invite audit log
agents/*/invites.ndjson

# Built speech-model packs (scripts/build-speech-pack.sh)
/dist/speech-packs/
