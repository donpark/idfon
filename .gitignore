**/node_modules/
.zig-cache/
*.app
/target/
audio-source.wav
audio-decoded.wav
audio-aligned.wav
audio-quality.json
stream-decoded.wav
stream-timings.json
geo-decoded.wav
geo-timings.json
# cli platform packages: binaries are built by scripts/build-cli.sh, not committed
cli/idfon-*/bin/
# generated copies of the root license files
cli/idfon-*/LICENSE-*

# eve channel platform packages: built by scripts/build-eve.sh
integrations/eve-idfon-*/bin/
integrations/eve-idfon-*/LICENSE-*
# third-party skills are per-machine installs, not repo content:
#   npx skills add vercel-labs/native        -> native-sdk
#   npx skills add jakubkrehel/make-interfaces-feel-better
#   npx skills add humanlayer/skills --skill show-me
.agents/skills/make-interfaces-feel-better/
.agents/skills/native-sdk/
.agents/skills/show-me/
# local tooling state — not repo content (our own .agents/skills/ ARE tracked)
.pi/
PONYTAIL-DEBT.md
skills-lock.json
*.wav
.DS_Store

# Runtime blob store written by the Eve holder when --blob-dir is not set
blobs/

# iOS app build artifacts
ios/Vendor/
ios/.derived/
mac/.build/
# mac app links these from Vendor/ (the dylib) or bakes it in (the AFM static
# lib); both are built by pnpm mac build / build-deps.sh, not repo content
mac/Vendor/

# eve agent build artifacts
agents/*/.output/
agents/*/.eve/
# directory provisioner invite audit log
agents/*/invites.ndjson

# Built speech-model packs (scripts/build-speech-pack.sh) + packed model
# artifacts (scripts/pack-tyger-models.mjs). Weights live on the model host
# (HF donpark/tyger-models), NEVER in git — an oversized pack is also what
# makes GitHub reject a push with "remote unpack failed".
/dist/
*.mlpackage/
*.aimodel/
*.mlirb
*.onnx
*.onnx.data
*.safetensors
weight.bin

# Benchmark result history (scripts/relay-bench.sh)
/bench-results/
/ports/tyger-swift/.build/
/scripts/__pycache__/
/ports/*/__pycache__/
/ports/tyger-coreai/.venv/

# xcodebuild/xcode per-user and build output (ios/upload.sh, mac/build.sh)
ios/build/
mac/build/
xcuserdata/
.swiftpm/

# phonon audition renders (regenerate: scripts/phonon-audition.sh)
docs/voice-audition-audio/
