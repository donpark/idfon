# Copy to .env on the droplet. compose.yaml interpolates these.
IDFON_EDGE_IMAGE=ghcr.io/donpark/idfon-edge:latest
IDFON_EDGE_DOMAIN=idfon.net
IDFON_EDGE_REQUIRE_TICKET=resource.read
IDFON_EDGE_RATE_LIMIT=120
# Host directory for the persistent edge identity.
IDFON_EDGE_STATE=/srv/idfon-edge
# Optional: identity as a 64-hex secret instead of /srv/idfon-edge/edge.key.
#IDFON_EDGE_KEY=
