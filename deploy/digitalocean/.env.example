# Copy to deploy/digitalocean/.env (gitignored) and fill in.
# Used by `pnpm deploy:do` (scripts/deploy-digitalocean.sh).

# Required: DigitalOcean API token with read+write (DNS + compute).
#DIGITALOCEAN_API_KEY=dop_v1_replace_me

# Optional. Defaults shown.
IDFON_DOMAIN=idfon.net
#IDFON_EMAIL=admin@idfon.net
#IDFON_DO_REGION=nyc3
#IDFON_DO_SIZE=s-1vcpu-1gb-intel
#IDFON_DO_IMAGE=ubuntu-24-04-x64
#IDFON_DO_NAME=idfon-edge
# 1 = create/assign a reserved IP (recommended); 0 = use the droplet's IP.
#IDFON_DO_RESERVED_IP=1
# Fingerprint, or path to a local .pub to import. Default: first local key.
#IDFON_DO_SSH_KEY=~/.ssh/id_ed25519.pub
# /32 allowed to SSH; default: auto-detected public IP.
#IDFON_ADMIN_IP=
IDFON_EDGE_IMAGE=ghcr.io/donpark/idfon-edge:latest

# VoIP push (docs/edge-deploy-checklist.md §C). Copy ~/.idfon/edge.apns.p8 to
# /srv/idfon-edge/edge.apns.p8 (mode 600) on the droplet. Key id / team
# default to the runbook's values in compose.yaml; override here if needed.
#IDFON_EDGE_PUSH_KEY_ID=
#IDFON_EDGE_PUSH_TEAM=
#IDFON_EDGE_PUSH_URL=https://api.push.apple.com

# bunny.net durable-files CDN (deploy/bunny/README.md). Also read by
# deploy/bunny/setup.sh, which creates the files.idfon.net CNAME here when
# DIGITALOCEAN_API_KEY is set.
#BUNNYNET_API_KEY=

# Durable files (docs/durable-files.md). The store lives on the state volume;
# leave the token empty for a read-only origin (rsync the files in), or set a
# secret to allow `idfon publish`.
#IDFON_FILES_DIR=/var/lib/idfon/files
#IDFON_FILES_TOKEN=
# Operations token: permanent pins for files the service needs (model packs).
#IDFON_FILES_OPS_TOKEN=
# User pin term in hours (default 24; 0 = no default).
#IDFON_FILES_USER_EXPIRY_HOURS=24
# Per-file cap for user publishes (MB; 0 = unlimited). 2 MB is about four
# minutes of 64 kbps Opus speech. Ops uploads are bound by the store quota.
#IDFON_FILES_MAX_UPLOAD_MB=2
#IDFON_FILES_QUOTA_MB=10240
# Cap a requested rental term (0 = no cap) and keep expired bytes this long.
#IDFON_FILES_MAX_EXPIRY_DAYS=0
#IDFON_FILES_GRACE_DAYS=30

# Enterprise relay (issue #26). Enable the co-located iroh relay and give the
# edge its URL; set the same on every peer so they meet on it.
#IDFON_DEPLOY_RELAY=1
#IDFON_RELAY_URLS=https://relay.idfon.net:8443
# Relay access — prefer allowlist or HTTP callout (no client secret):
#IDFON_RELAY_ALLOWLIST=<endpoint-id>,<endpoint-id>
#IDFON_RELAY_AUTH_URL=https://auth.example.com/relay
#IDFON_RELAY_AUTH_TOKEN=
# ...or a shared token, presented at runtime by clients (never compiled in):
#IDFON_RELAY_TOKEN=
