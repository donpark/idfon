<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode automatic signing registers the
	     App ID service and provisions the profile at build; distribution
	     signing swaps the environment via the profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
